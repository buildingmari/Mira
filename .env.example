# ───────────────────────────────────────────────────────────────────────────
# MIRA — Environment Variables Template
# Copy this file to .env.local (never commit .env.local to git!)
# Set these same vars in Vercel / Netlify / your hosting dashboard.
# ───────────────────────────────────────────────────────────────────────────

# Supabase project URL (Project Settings > API > Project URL)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings > API > anon public)
# This key is safe to ship to browsers — security is enforced by RLS policies.
VITE_SUPABASE_ANON_KEY=your-anon-key-here
