{
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },

    {
      "src": "/(.*\\.(png|jpg|jpeg|gif|svg|ico|webp))",
      "dest": "/$1"
    },

    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": "admin.halo-mira.com" }],
      "dest": "/admin/index.html"
    },

    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
