{
  "rewrites": [
    {
      "has": [
        {
          "type": "host",
          "value": "admin.halo-mira.com"
        }
      ],
      "source": "/(.*)",
      "destination": "/admin/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/dashboard/(.*)",
      "destination": "/dashboard/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
